#!/bin/sh
# Stand-in for ninja in launcher_tests; behaviour from $FAKE_NINJA_MODE.
work=
jobs=
prev=
for a in "$@"; do
  [ "$prev" = "-C" ] && work=$a
  case "$a" in -j*) jobs=$a ;; esac
  prev=$a
done
echo "$jobs" >> "${FAKE_JOBS_FILE:-$work/jobs.txt}"
# A real ninja fails when the cmake/compiler paths in build.ninja are gone.
configured_with=$(cat "$work/build.ninja" 2>/dev/null)
if [ -n "$configured_with" ] && [ ! -e "$configured_with" ]; then
  echo "ninja: error: rebuilding 'build.ninja': $configured_with: No such file or directory"
  exit 1
fi
case "$FAKE_NINJA_MODE" in
  fail)
    echo "[1/3] Building CXX object a.o"
    echo "No space left on device"
    exit 1 ;;
  oomonce)
    # The OOM killer kills the compiler, not ninja; ninja then exits 1.
    if [ ! -f "$work/oom_marker" ]; then
      : > "$work/oom_marker"
      echo "[1/3] Building CXX object a.o"
      sh -c 'kill -9 $$'
      echo "c++: fatal error: Killed signal terminated program cc1plus"
      echo "ninja: build stopped: subcommand failed."
      exit 1
    fi ;;
  slow)
    echo "[1/3] Building CXX object a.o"
    sleep 30
    exit 0 ;;
esac
echo "[1/3] Building CXX object a.o"
echo "[2/3] Building CXX object b.o"
echo "[3/3] Linking CXX executable transformers"
echo game > "$work/transformers"

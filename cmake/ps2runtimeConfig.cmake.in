# Prebuilt Transformers port runtime (share/transformers-port/runtime).
# Dependencies come from runtime/deps when present (the AppImage ships static
# copies there), else from the system.
include(CMakeFindDependencyMacro)
get_filename_component(_ps2rt "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
if(EXISTS "${_ps2rt}/deps")
  list(PREPEND CMAKE_PREFIX_PATH "${_ps2rt}/deps")
endif()

find_dependency(SDL3 CONFIG HINTS "@SDL3_DIR@")
find_dependency(PNG)
find_dependency(Freetype)
find_dependency(LibLZMA)
find_dependency(ZLIB)
find_dependency(OpenGL)

if(NOT TARGET PkgConfig::GIO)
  if(EXISTS "${_ps2rt}/deps/lib/libgio-2.0.so")
    # Link-time copies only; the host's glib is used at run time.
    add_library(PkgConfig::GIO INTERFACE IMPORTED)
    set_target_properties(PkgConfig::GIO PROPERTIES INTERFACE_LINK_LIBRARIES
      "${_ps2rt}/deps/lib/libgio-2.0.so;${_ps2rt}/deps/lib/libgobject-2.0.so;${_ps2rt}/deps/lib/libglib-2.0.so")
  else()
    find_dependency(PkgConfig)
    pkg_check_modules(GIO REQUIRED IMPORTED_TARGET gio-2.0)
  endif()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/ps2runtimeTargets.cmake")
